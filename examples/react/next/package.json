{
  "name": "@open-feod/example-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 5178 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --port 4178 --hostname 127.0.0.1",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:oxlint": "oxlint src --deny-warnings",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.0",
    "@o-feod/eslint-structure-plugin": "workspace:*",
    "@o-feod/oxlint-structure-plugin": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxlint": "1.86.0",
    "sass-embedded": "catalog:",
    "typescript": "catalog:typescript6",
    "typescript-eslint": "8.59.4"
  },
  "feod": {
    "srcRoot": "src",
    "layerDirs": {
      "pages": "screens",
      "global": "globals"
    },
    "modules": {
      "publicEntries": [
        "index.ts",
        "server.ts"
      ]
    },
    "extra": {
      "confine": [
        {
          "name": "server-only",
          "imports": [
            "server-only",
            "next/headers",
            "next/cache"
          ],
          "allowedIn": [
            "src/app/**",
            "src/modules/*/server.ts",
            "src/modules/*/server/**"
          ],
          "message": "server-only, next/headers и next/cache допустимы только в app и в серверном входе модуля (server.ts)."
        }
      ]
    }
  }
}
