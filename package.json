{
  "name": "open-feod",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm --filter docs build",
    "preview": "pnpm --filter docs preview",
    "dev:example": "pnpm --filter @open-feod/example-vue-spa dev",
    "build:example": "pnpm --filter @open-feod/example-vue-spa build",
    "test:example": "pnpm --filter @open-feod/example-vue-spa test:unit",
    "test:e2e:example": "pnpm --filter @open-feod/example-vue-spa test:e2e",
    "lint:example": "pnpm --filter @open-feod/example-vue-spa lint",
    "install:all": "pnpm install",
    "clean": "echo 'Удалите node_modules вручную или используйте: pnpm store prune'",
    "skill:pack": "node scripts/pack-skill.mjs",
    "skill:check": "node scripts/pack-skill.mjs --check",
    "skill:smoke": "node scripts/smoke-skill.mjs",
    "skill:verify": "pnpm --filter @open-feod/skill-cli typecheck && pnpm --filter @open-feod/skill-cli test && pnpm run skill:check && pnpm run skill:smoke",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint"
  },
  "devDependencies": {
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
